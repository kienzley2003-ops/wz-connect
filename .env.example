# === WZ Connect — variáveis de ambiente ===
# Copie para .env e ajuste. NUNCA versione o .env.

NODE_ENV=development

# --- Backend ---
PORT=3000
HOST=0.0.0.0

# --- Banco central WZ_CONNECT_CORE ---
# Docker publica o postgres-core em 5435 no host (evita conflito com outros Postgres).
CORE_DATABASE_URL=postgres://wz_connect:wz_connect@localhost:5435/wz_connect_core
POSTGRES_USER=wz_connect
POSTGRES_PASSWORD=wz_connect
POSTGRES_DB=wz_connect_core

# --- Auth ---
# Segredo p/ assinatura (fase de auth global usará chaves RSA/JWKS)
JWT_SECRET=change-me-min-32-chars-000000000000

# --- Cifra de credenciais de tenant (ADR-006) ---
# Chave-mestra (KEK) para AES-256-GCM. Gere: openssl rand -base64 32
TENANT_CREDENTIALS_KEK=change-me-base64-32-bytes-key-000000000000000
