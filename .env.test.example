# Sobrepõe DATABASE_URL só para `pnpm test` (Vitest seta NODE_ENV=test
# automaticamente) — ver apps/backend/src/env.ts. Todas as outras variáveis
# (JWT_SECRET, REDIS_URL, etc.) continuam vindo do .env normal.
#
# wz_connect_test é criado automaticamente pelo docker-compose.yml
# (docker/init-test-db.sql) na primeira inicialização do container. Copie
# este arquivo para .env.test (gitignored) — os valores padrão já funcionam
# em dev local, sem precisar editar nada.
DATABASE_URL=postgresql://wzconnect:wzconnect@localhost:5435/wz_connect_test
