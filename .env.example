# Postgres (docker-compose) — porta 5435 no host para não colidir com
# wz-masterfila (5433), wz-desk/wz-agente (5432) e wz-orc (5434).
POSTGRES_USER=wzconnect
POSTGRES_PASSWORD=wzconnect
POSTGRES_DB=wz_connect
DATABASE_URL=postgresql://wzconnect:wzconnect@localhost:5435/wz_connect

# Redis (docker-compose) — porta 6380 no host.
REDIS_URL=redis://localhost:6380

# Backend
NODE_ENV=development
PORT=3000
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
BASE_DOMAIN=localhost

# Stripe (ADR 0009) — opcional em dev, obrigatório para testar billing real
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NFe.io (ADR 0010) — opcional em dev, obrigatório para testar emissão de NF-e
NFEIO_API_KEY=

# Frontend (Vite) — aponta para o backend local
VITE_API_TARGET=http://localhost:3000
